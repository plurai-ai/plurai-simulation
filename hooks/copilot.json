{
  "description": "Plurai simulation hooks for copilot, generated from hooks/registry.py by scripts/dev/generate_harness_files.py. Edit the registry, not this file.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^plurai-(generate_env_start|generate_evals_start|generate_scenarios_start|ground_workspace_start|optimize_eval_start|prewarm_dimension_graph_start|release_verdict_recompute|solvability_check_start|suite_diagnostics_start|upload_doc_examples_start|upload_run_artifacts_start|upload_scenario_bundle_start)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot --bundle regen_gate,command_run_id,halt_gate",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "skill",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" skill -- python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot flow_autoarm",
            "timeout": 10,
            "windows": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot flow_autoarm"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|ask_user",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" -- python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot ask_guard",
            "timeout": 10,
            "windows": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot ask_guard"
          }
        ]
      },
      {
        "matcher": "Bash|bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" token -- python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot plugin_root",
            "timeout": 10,
            "windows": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot plugin_root"
          }
        ]
      },
      {
        "matcher": "Read|view",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" token -- python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot plugin_root",
            "timeout": 10,
            "windows": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot plugin_root"
          }
        ]
      },
      {
        "matcher": "^plurai-(edit_session_start|interact_edit_session|interact_with_scenario_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot placeholder_guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^plurai-generate_scenarios_start$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot regen_spent",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|bash|Agent|task|read_bash|read_powershell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" -- python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot pending_register",
            "timeout": 10,
            "windows": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot pending_register"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|ask_user",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" -- python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot ask_answered",
            "timeout": 10,
            "windows": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot ask_answered"
          }
        ]
      },
      {
        "matcher": "^plurai-.*|Bash|bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" -- python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot failure_notice",
            "timeout": 10,
            "windows": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot failure_notice"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot --bundle session_glossary,session_pin",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" prompt -- python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot --bundle flow_arm,pending_register",
            "timeout": 10,
            "windows": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot --bundle flow_arm,pending_register"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot --bundle flow_cleanup,session_pin",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" -- python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot pending_register",
            "timeout": 10,
            "windows": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot pending_register"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" -- python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot pending_register",
            "timeout": 10,
            "windows": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot pending_register"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" -- python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot report_guard",
            "timeout": 10,
            "windows": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" --harness copilot report_guard"
          }
        ]
      }
    ]
  }
}
