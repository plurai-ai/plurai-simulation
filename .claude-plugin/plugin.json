{
  "name": "plurai-simulation",
  "version": "1.0.5",
  "description": "Set up Plurai simulation for any AI agent. Analyzes agent code, stubs production dependencies, patches the agent's tool bindings with mock-aware interception, and generates simulate.py.",
  "author": {
    "name": "Plurai AI",
    "url": "https://plurai.ai"
  },
  "homepage": "https://github.com/plurai-ai/plurai-simulation#readme",
  "repository": "https://github.com/plurai-ai/plurai-simulation",
  "keywords": [
    "testing",
    "simulation",
    "agents",
    "mocking",
    "langgraph",
    "evaluation"
  ],
  "mcpServers": {
    "plurai": {
      "type": "http",
      "url": "${PLURAI_URL:-https://sandbox.plurai.ai/v1}/mcp",
      "headers": {
        "Authorization": "Bearer ${PLURAI_TOKEN:-}",
        "X-Plurai-Client": "plurai-simulation/1.0.5"
      },
      "headersHelper": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/credentials.py\" --headers"
    }
  }
}
